{
  "name": "drift-exec",
  "version": "0.1.0",
  "description": "Stateless CLI for Drift perp execution (devnet/paper). Invoked by the GridRunner Python bot over subprocess.",
  "type": "module",
  "bin": {
    "drift-exec": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@drift-labs/sdk": "2.156.0",
    "@solana/web3.js": "1.98.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
